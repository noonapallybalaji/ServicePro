              "type": "string"
            },
            {
              "id": "6f0a3a51-2d6b-4a0e-9c3e-0a0e3a1f0102",
              "name": "trackingBaseUrl",
              "value": "https://REPLACE-with-your-website-hostname",
              "type": "string"
            },
            {
              "id": "6f0a3a51-2d6b-4a0e-9c3e-0a0e3a1f0103",
              "name": "testPincode",
              "value": "500081",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5b1d0c3e-6c35-4c55-9d0d-0a0e3a1f0002",
      "name": "ServicePro Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "={{ $('ServicePro Settings').first().json.apiBaseUrl }}/api/v1/catalog/categories",
        "options": {
          "timeout": 15000
        }
      },
      "id": "5b1d0c3e-6c35-4c55-9d0d-0a0e3a1f0003",
      "name": "get_service_catalog",
