      "position": [440, 0]
    },
    {
      "parameters": {
        "url": "={{ $('ServicePro Settings').first().json.apiBaseUrl }}/api/v1/catalog/serviceability/{{ $('ServicePro Settings').first().json.testPincode }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "5b1d0c3e-6c35-4c55-9d0d-0a0e3a1f0004",
      "name": "check_serviceability",
      "type": "n8n-nodes-base.httpRequest",
