      "name": "Run check",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "6f0a3a51-2d6b-4a0e-9c3e-0a0e3a1f0101",
