{
  "expo": {
    "name": "Pakka Fix",
    "slug": "pakka-fix",
    "scheme": "pakkafix",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.pakkafix.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.pakkafix.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#001D3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#001D3F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pakka Fix uses your location to find your PIN code and to help the technician reach you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pakka Fix lets you add photos of the appliance or the problem to a help request.",
          "cameraPermission": "Pakka Fix lets you take a photo of the appliance or the problem for a help request."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
