# ServicePro API — settings for running behind Cloudflare Tunnel (ASPNETCORE_ENVIRONMENT=Public).
#
# Copy to apps/api/.env.public (git-ignored) and fill in. Never commit the filled-in file.
# Start with:  powershell -ExecutionPolicy Bypass -File apps/api/scripts/start-public-api.ps1
#
# Format: KEY=VALUE per line. Double underscores (__) are configuration sections.

# PostgreSQL. Keep the database itself private: only the API connects to it.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=servicepro;Username=servicepro;Password=CHANGE_ME

# JWT signing key: at least 32 random characters, NOT the development key from the repo.
# Generate one:  powershell -File apps/api/scripts/new-signing-key.ps1
Auth__SigningKey=

# The public customer website (where /t/<token> tracking pages live), https, no trailing slash.
# Used in WhatsApp messages and in tracking links returned to n8n.
Notifications__PublicSiteUrl=https://your-site-hostname

# n8n integration key: SHA-256 hash only (the key itself goes into n8n, nowhere else).
# Generate both:  powershell -File apps/api/scripts/new-integration-key.ps1
Integrations__Keys__n8n=

# Optional: first owner account if the database is empty (otherwise ignored).
# Seed__OwnerEmail=
# Seed__OwnerPassword=
