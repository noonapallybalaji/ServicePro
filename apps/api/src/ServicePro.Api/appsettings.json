{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Auth": {
    "Issuer": "servicepro",
    "Audience": "servicepro",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "StaffSessionHours": 12,
    "TechnicianSessionDays": 30
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Notifications": {
    "PublicSiteUrl": "https://example.invalid",
    "OtpChannel": "Sms",
    "WhatsApp": {
      "PhoneNumberId": "",
      "AccessToken": ""
    },
    "Sms": {
      "Provider": "",
      "AuthKey": ""
    }
  },
  "Legal": {
    "PolicyVersion": "unpublished-draft"
  },
  "Storage": {
    "Local": {
      "RootPath": ".storage"
    }
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "PublicPerMinute": 120
  }
}
