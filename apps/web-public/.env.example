# Customer site configuration (src/site.ts). Copy to .env.production and fill in.
# Only VITE_SITE_URL and VITE_BUSINESS_NAME are needed to build; everything else is optional
# and is simply left out of the pages and structured data until set.

# Production origin, no trailing slash. Used for canonical URLs, Open Graph URLs and the sitemap.
VITE_SITE_URL=https://www.example.in
VITE_BUSINESS_NAME=ServicePro Appliance Care
# VITE_SITE_DESCRIPTION=

# Contact (E.164 phone). Shown on the site and in LocalBusiness JSON-LD when set.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=

# Primary service location (defaults: Hyderabad, Telangana, IN, India).
# VITE_SERVICE_CITY=Hyderabad
# VITE_SERVICE_REGION=Telangana
# VITE_SERVICE_COUNTRY=IN
# VITE_SERVICE_COUNTRY_NAME=India

# Only if the business has a public street address (otherwise it is described as a service-area business).
VITE_BUSINESS_STREET_ADDRESS=
VITE_BUSINESS_POSTAL_CODE=

# Comma-separated profile URLs (Google Business Profile, Facebook, Instagram…) for JSON-LD sameAs.
VITE_SOCIAL_PROFILES=
# e.g. @yourhandle
VITE_TWITTER_HANDLE=

# Google Search Console "HTML tag" verification: paste only the content="…" value.
VITE_GOOGLE_SITE_VERIFICATION=

# Terms, Privacy and Cancellation & refund pages. Until ALL five are set, those pages carry a
# "draft" notice and are kept out of search results. Have the wording reviewed by a lawyer.
# VITE_LEGAL_ENTITY_NAME=
# VITE_GRIEVANCE_OFFICER_NAME=
# VITE_GRIEVANCE_OFFICER_EMAIL=
# Must match Legal__PolicyVersion on the API (YYYY-MM-DD):
# VITE_POLICY_EFFECTIVE_DATE=
# VITE_REFUND_WORKING_DAYS=

# Map on the tracking page while the technician is on the way. Defaults to OpenStreetMap tiles,
# which suit light use only; for real traffic use a tile provider you have an account with.
# VITE_MAP_TILE_URL=
# VITE_MAP_ATTRIBUTION=
