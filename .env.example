# Copy to .env (git-ignored). Values here are LOCAL DEVELOPMENT defaults only.

# docker compose
POSTGRES_USER=servicepro
POSTGRES_PASSWORD=servicepro
POSTGRES_DB=servicepro
POSTGRES_PORT=5432
SEQ_PORT=5341

# API (ASP.NET Core reads these as configuration; `__` = section separator)
ConnectionStrings__Database=Host=localhost;Port=5432;Database=servicepro;Username=servicepro;Password=servicepro
Auth__SigningKey=dev-only-signing-key-change-me-0123456789abcdef
Seed__OwnerEmail=owner@servicepro.local
Seed__OwnerPassword=ChangeMe!2026

# Optional providers (leave empty to use the logging/no-op providers)
Notifications__WhatsApp__PhoneNumberId=
Notifications__WhatsApp__AccessToken=
